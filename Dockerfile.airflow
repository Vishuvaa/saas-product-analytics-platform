# Airflow image with this project installed. NOTE: unverified in the authoring sandbox (no Docker available there).
FROM apache/airflow:2.9.3-python3.11
USER airflow
COPY --chown=airflow:root pyproject.toml /opt/project/pyproject.toml
COPY --chown=airflow:root saas_platform /opt/project/saas_platform
RUN pip install --no-cache-dir \
      --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.11.txt" \
      pyarrow duckdb==1.1.3 psycopg2-binary \
 && pip install --no-cache-dir --no-deps /opt/project
